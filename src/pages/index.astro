---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Testimonials from "../components/Testimonials.astro";
import site from "../data/site.json";
---

<Base
	title={undefined}
	description="Master Carpenters LLC — custom decks, siding, windows, and exterior work in Cedar Rapids, Iowa. Call Layne Stark for a free estimate."
>
	<Hero />

	<div class="trust-bar">
		<div class="container trust-inner">
			<div class="trust-item">
				<span class="trust-num">20+</span>
				<span class="trust-label">5-Star Reviews</span>
			</div>
			<div class="trust-divider"></div>
			<div class="trust-item">
				<span class="trust-num">10+</span>
				<span class="trust-label">Years Experience</span>
			</div>
			<div class="trust-divider"></div>
			<div class="trust-item">
				<span class="trust-num">Cedar Rapids</span>
				<span class="trust-label">Iowa</span>
			</div>
			<div class="trust-divider"></div>
			<div class="trust-item trust-cta">
				<a href={`tel:${site.phoneTel}`} class="trust-phone">{site.phone}</a>
				<span class="trust-label">Call or text Layne</span>
			</div>
		</div>
	</div>

	<Features />
	<Testimonials />
</Base>

<style>
	.trust-bar { background: var(--color-brand); color: #fff; padding: var(--spacing-xl) 0; }
	.trust-inner {
		display: flex; align-items: center; justify-content: center;
		gap: var(--spacing-2xl); flex-wrap: wrap;
	}
	.trust-item { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; }
	.trust-num { font-size: var(--font-size-2xl); font-weight: 700; line-height: 1; color: #fff; }
	.trust-label {
		font-size: var(--font-size-xs); text-transform: uppercase;
		letter-spacing: 0.08em; opacity: 0.8; color: #fff;
	}
	.trust-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.25); }
	.trust-phone {
		font-size: var(--font-size-xl); font-weight: 700; color: #fff; letter-spacing: 0.01em;
	}
	.trust-cta .trust-label { margin-top: 0.1rem; }
	@media (max-width: 600px) {
		.trust-divider { display: none; }
		.trust-inner { gap: var(--spacing-xl); justify-content: space-around; }
	}
</style>
